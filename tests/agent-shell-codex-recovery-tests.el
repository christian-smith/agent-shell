;;; agent-shell-codex-recovery-tests.el --- Idle shell recovery tests -*- lexical-binding: t; -*-

;;; Code:

(require 'ert)
(require 'agent-shell)
(require 'agent-shell-codex-app-server)

(ert-deftest agent-shell-codex-recovery-restores-prompt-and-preserves-draft ()
  "An idle runtime restores a missing prompt without losing draft or queue."
  (dolist (live-prompt '(nil t))
    (with-temp-buffer
      (setq major-mode 'agent-shell-mode)
      (let* ((client (agent-shell-codex-app-server-make-client :command "sh"))
             (queue (list "queued message"))
             (agent-shell--state `((:client . ,client) (:pending-prompts . ,queue)))
             (shell-maker--config (make-shell-maker-config :name "agent" :prompt "Codex> "))
             (shell-maker--busy t)
             (shell-maker--current-request-id 3)
             (shell-maker-finish-output-hook nil)
             (comint-last-prompt nil)
             (comint-last-output-start (make-marker))
             (comint-prompt-regexp "^Codex> ")
             (comint-use-prompt-regexp nil)
             (process (make-pipe-process :name "recovery-test" :buffer (current-buffer) :noquery t))
             (questions (map-elt client :async-questions))
             request)
        (unwind-protect
            (cl-letf (((symbol-function 'agent-shell-codex-app-server--client-started-p) (lambda (_) t))
                      ((symbol-function 'shell-maker-buffer) (lambda (_) (current-buffer)))
                      ((symbol-function 'agent-shell-heartbeat-stop) #'ignore)
                      ((symbol-function 'agent-shell--update-header-and-mode-line) #'ignore)
                      ((symbol-function 'agent-shell-codex-app-server--send-rpc-request)
                       (lambda (&rest args) (setq request args))))
              (map-put! client :thread-id "thread")
              (insert (propertize "Conversation\n" 'read-only t 'field 'output))
              (when live-prompt
                (agent-shell--print-prompt)
                (insert "draft input"))
              (let ((before (buffer-string)))
                (agent-shell-codex-app-server-recover)
                (should (equal (plist-get request :method) "thread/read"))
                (should (equal (plist-get request :params) '((threadId . "thread"))))
                (funcall (plist-get request :on-success)
                         '((thread . ((id . "thread") (status . ((type . "idle")))))))
                (should-not (shell-maker-busy))
                (should (agent-shell--live-input-prompt-p comint-last-prompt))
                (should (eq questions (map-elt client :async-questions)))
                (should (eq queue (map-elt agent-shell--state :pending-prompts)))
                (if live-prompt
                    (should (equal before (buffer-string)))
                  (should (string-prefix-p before (buffer-string))))
                (goto-char (point-max))
                (insert " editable")
                (should (string-suffix-p " editable" (buffer-string)))))
          (delete-process process))))))

(ert-deftest agent-shell-codex-recovery-refuses-tracked-work ()
  "Recovery does not probe or alter a shell with work already in flight."
  (dolist (case '(:active-turn-id :pending-prompt :reconnecting :active-requests :pending-requests))
    (with-temp-buffer
      (setq major-mode 'agent-shell-mode)
      (let* ((client (agent-shell-codex-app-server-make-client :command "sh"))
             (agent-shell--state (list (cons :client client) (cons :active-requests nil)))
             (shell-maker--config (make-shell-maker-config :name "agent"))
             (shell-maker--busy t))
        (map-put! client :thread-id "thread")
        (pcase case
          (:active-requests (map-put! agent-shell--state case '(pending)))
          (:pending-requests (puthash 1 '((:method . "pending")) (map-elt client case)))
          (_ (map-put! client case t)))
        (cl-letf (((symbol-function 'agent-shell-codex-app-server--client-started-p) (lambda (_) t))
                  ((symbol-function 'agent-shell-codex-app-server--send-rpc-request)
                   (lambda (&rest _) (ert-fail "Unexpected runtime probe"))))
          (should-error (agent-shell-codex-app-server-recover) :type 'user-error)
          (should (shell-maker-busy)))))))

(ert-deftest agent-shell-codex-recovery-refuses-stale-or-nonidle-response ()
  "Non-idle responses and shell changes never finish another turn."
  (dolist (case '(active not-loaded system-error unknown wrong-thread changed-thread changed-client
                         active-turn pending-prompt pending-rpc active-request reconnect new-input failure))
    (with-temp-buffer
      (setq major-mode 'agent-shell-mode)
      (let* ((client (agent-shell-codex-app-server-make-client :command "sh"))
             (agent-shell--state (list (cons :client client) (cons :active-requests nil)))
             (shell-maker--config (make-shell-maker-config :name "agent"))
             (shell-maker--current-request-id 1)
             (shell-maker--busy t)
             request)
        (map-put! client :thread-id "thread")
        (insert "Draft")
        (cl-letf (((symbol-function 'agent-shell-codex-app-server--client-started-p) (lambda (_) t))
                  ((symbol-function 'agent-shell-codex-app-server--send-rpc-request)
                   (lambda (&rest args) (setq request args)))
                  ((symbol-function 'agent-shell--finish-output)
                   (lambda (&rest _) (ert-fail "Unexpected shell completion"))))
          (agent-shell-codex-app-server-recover)
          (pcase case
            ('changed-thread (map-put! client :thread-id "other"))
            ('changed-client (map-put! agent-shell--state :client 'other))
            ('active-turn (map-put! client :active-turn-id "new"))
            ('pending-prompt (map-put! client :pending-prompt 'pending))
            ('pending-rpc (puthash 99 '((:method . "pending")) (map-elt client :pending-requests)))
            ('active-request (map-put! agent-shell--state :active-requests '(pending)))
            ('reconnect (map-put! client :reconnecting t))
            ('new-input (setq shell-maker--current-request-id 2)))
          (if (eq case 'failure)
              (funcall (plist-get request :on-failure) '((message . "Unavailable")) nil)
            (funcall (plist-get request :on-success)
                     `((thread . ((id . ,(if (eq case 'wrong-thread) "other" "thread"))
                                  (status . ((type . ,(pcase case
                                                       ('active "active") ('not-loaded "notLoaded")
                                                       ('system-error "systemError") ('unknown "future")
                                                       (_ "idle"))))))))))
          (should (shell-maker-busy))
          (should (equal (buffer-string) "Draft")))))))

(ert-deftest agent-shell-codex-recovery-timeout-cleans-only-probe ()
  "A timeout removes its own pending probe and ignores late success."
  (with-temp-buffer
    (setq major-mode 'agent-shell-mode)
    (let* ((client (agent-shell-codex-app-server-make-client :command "sh"))
           (agent-shell--state `((:client . ,client)))
           (shell-maker--config (make-shell-maker-config :name "agent"))
           (shell-maker--current-request-id 1)
           (shell-maker--busy t)
           request timeout)
      (map-put! client :thread-id "thread")
      (cl-letf (((symbol-function 'agent-shell-codex-app-server--client-started-p) (lambda (_) t))
                ((symbol-function 'agent-shell-codex-app-server--send-rpc-request)
                 (lambda (&rest args)
                   (setq request args)
                   (puthash 1 `((:on-success . ,(plist-get args :on-success)))
                            (map-elt client :pending-requests))))
                ((symbol-function 'run-at-time)
                 (lambda (seconds _repeat callback &rest args)
                   (should (= seconds 10))
                   (setq timeout (lambda () (apply callback args)))
                   'timer))
                ((symbol-function 'cancel-timer) #'ignore)
                ((symbol-function 'agent-shell--finish-output)
                 (lambda (&rest _) (ert-fail "Late probe repaired the shell"))))
        (agent-shell-codex-app-server-recover)
        (puthash 2 '((:method . "unrelated")) (map-elt client :pending-requests))
        (funcall timeout)
        (should-not (gethash 1 (map-elt client :pending-requests)))
        (should (equal (gethash 2 (map-elt client :pending-requests)) '((:method . "unrelated"))))
        (funcall (plist-get request :on-success)
                 '((thread . ((id . "thread") (status . ((type . "idle")))))))
        (should (shell-maker-busy))))))

;; Shared fixture for an idle-looking shell with a stale busy flag.
(defmacro agent-shell-codex-recovery-tests--with-shell (&rest body)
  "Run BODY in a busy shell whose running client has thread \"thread\"."
  (declare (indent 0) (debug t))
  `(with-temp-buffer
     (setq major-mode 'agent-shell-mode)
     (let* ((client (agent-shell-codex-app-server-make-client :command "sh"))
            (agent-shell--state (list (cons :client client) (cons :active-requests nil)))
            (shell-maker--config (make-shell-maker-config :name "agent"))
            (shell-maker--current-request-id 1)
            (shell-maker--busy t))
       (map-put! client :thread-id "thread")
       (cl-letf (((symbol-function 'agent-shell-codex-app-server--client-started-p) (lambda (_) t)))
         ,@body))))

(ert-deftest agent-shell-codex-recovery-uses-real-request-lifecycle ()
  "The probe is tracked until its response, then no longer counts as work."
  (agent-shell-codex-recovery-tests--with-shell
    (let (written repaired released)
      (cl-letf (((symbol-function 'agent-shell-codex-app-server--write-message)
                 (lambda (_client message) (setq written message)))
                ((symbol-function 'agent-shell-heartbeat-stop) #'ignore)
                ((symbol-function 'agent-shell--update-header-and-mode-line) #'ignore)
                ((symbol-function 'agent-shell--finish-output)
                 (lambda (&rest _) (setq shell-maker--busy nil repaired t)))
                ((symbol-function 'agent-shell--sync-system-sleep)
                 ;; Sleep is released only after the shell stops being busy.
                 (lambda (_state) (setq released (not (shell-maker-busy))))))
        (agent-shell-codex-app-server-recover)
        (should (equal (map-elt written 'method) "thread/read"))
        (should (= (hash-table-count (map-elt client :pending-requests)) 1))
        (agent-shell-codex-app-server--handle-response
         client `((id . ,(map-elt written 'id))
                  (result . ((thread . ((id . "thread") (status . ((type . "idle")))))))))
        (should repaired)
        (should released)
        (should (= (hash-table-count (map-elt client :pending-requests)) 0))))))

(ert-deftest agent-shell-codex-recovery-send-failure-leaves-no-probe ()
  "A probe that cannot be written is removed and the shell stays unchanged."
  (agent-shell-codex-recovery-tests--with-shell
    (let ((timers timer-list))
      (cl-letf (((symbol-function 'agent-shell-codex-app-server--write-message)
                 (lambda (&rest _) (error "Broken pipe")))
                ((symbol-function 'agent-shell--finish-output)
                 (lambda (&rest _) (ert-fail "Failed probe repaired the shell"))))
        (agent-shell-codex-app-server-recover)
        (should (= (hash-table-count (map-elt client :pending-requests)) 0))
        (should (equal timer-list timers))
        (should (shell-maker-busy))))))

(ert-deftest agent-shell-codex-recovery-ignores-dead-shell ()
  "A response for a killed shell neither errors nor repairs anything."
  (let (request)
    (agent-shell-codex-recovery-tests--with-shell
      (cl-letf (((symbol-function 'agent-shell-codex-app-server--send-rpc-request)
                 (lambda (&rest args) (setq request args)))
                ;; An inactive timer: the real ten-second timeout must not fire.
                ((symbol-function 'run-at-time) (lambda (&rest _) (timer-create))))
        (agent-shell-codex-app-server-recover)))
    (cl-letf (((symbol-function 'agent-shell--finish-output)
               (lambda (&rest _) (ert-fail "Dead shell was repaired"))))
      (funcall (plist-get request :on-success)
               '((thread . ((id . "thread") (status . ((type . "idle"))))))))))

(provide 'agent-shell-codex-recovery-tests)

